# Copie para .env.local (na raiz do projeto). As chaves também podem ser salvas pela tela "Configurações".
# O arquivo .env.local nunca é enviado ao navegador nem versionado.

# --- Provedores de IA (opcionais; sem chave o app usa o modo "heuristic" 100% local) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Binários (opcional: detectados automaticamente pelo PATH / instalação winget) ---
# FFMPEG_PATH=C:\caminho\ffmpeg.exe
# FFPROBE_PATH=C:\caminho\ffprobe.exe
# PYTHON_PATH=D:\trabalho\videos\.venv\Scripts\python.exe

# --- Pastas (opcional) ---
# DATA_DIR=./data

# --- Worker ---
# Intervalo de polling da fila (ms)
WORKER_POLL_MS=2000
