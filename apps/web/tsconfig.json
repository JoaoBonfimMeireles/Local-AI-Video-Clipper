{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@clipper/shared": ["../../packages/shared/src/index.ts"],
      "@clipper/shared/server": ["../../packages/shared/src/server.ts"],
      "@clipper/ai-providers": ["../../packages/ai-providers/src/index.ts"],
      "@clipper/video-processing": ["../../packages/video-processing/src/index.ts"],
      "@clipper/clip-selection": ["../../packages/clip-selection/src/index.ts"],
      "@clipper/editing-planner": ["../../packages/editing-planner/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "worker"]
}
